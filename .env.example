# Токен бота Telegram. Боевое значение в репозиторий не кладётся.
BOT_TOKEN=

# PostgreSQL, например postgresql+psycopg://dockbot@127.0.0.1:5432/dockbot
DATABASE_URL=

# Часовой пояс склада, имя IANA. Пусто: Europe/Moscow.
WAREHOUSE_TIMEZONE=

# Геометка склада. Обе строки можно оставить пустыми.
# Без пары координат служба напоминаний не стартует. Опрос Telegram продолжается.
WAREHOUSE_LATITUDE=
WAREHOUSE_LONGITUDE=

# Окно отмены и переноса, целые часы. Пусто: 2.
CANCEL_WINDOW_HOURS=

# Сетка слотов. Пустые ключи берут стенд: ворота 1 и 2, будни, 08:00–18:00, слот 60.
# Пример своих ворот: 1:Ворота 1;2:Ворота 2
GATES=
# Дни ISO: 1=понедельник … 7=воскресенье. Пусто: 1,2,3,4,5
GATE_WEEKDAYS=
# Пусто: 08:00 и 18:00
GATE_OPEN=
GATE_CLOSE=
# Пусто: 60
SLOT_MINUTES=

# Персонал. Пустой ключ не стирает уже записанных.
# Если роли ещё нет, старт создаёт охрану 1111, кладовщика 2222 и администратора 3333.
# Свой четырёхзначный PIN не переписывается.
# Форма: роль:имя:PIN или роль:имя:PIN:telegram_id
# Роль: security, warehouse или admin. Несколько записей через точку с запятой.
# Значение в репозиторий не кладут.
STAFF=

# Каталог журнала. Пусто: на Windows C:\Apps\DockBot\logs, иначе только консоль.
LOG_DIR=

# Каталог дампов pg_dump, отдельно от журнала.
# Пусто: на Windows C:\Apps\DockBot\backups, иначе python -m dockbot.backup просит каталог.
BACKUP_DIR=
