# Токен бота Telegram. Боевое значение в репозиторий не кладётся.
BOT_TOKEN=

# PostgreSQL, например postgresql+psycopg://dockbot@127.0.0.1:5432/dockbot
DATABASE_URL=

# Часовой пояс склада, имя IANA. В ТЗ не задан.
WAREHOUSE_TIMEZONE=

# Геометка склада. В ТЗ не задана.
WAREHOUSE_LATITUDE=
WAREHOUSE_LONGITUDE=

# Окно отмены и переноса, целые часы. В ТЗ не задано.
CANCEL_WINDOW_HOURS=
