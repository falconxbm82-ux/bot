# Токен бота Telegram. Боевое значение в репозиторий не кладётся.
BOT_TOKEN=

# PostgreSQL, например postgresql+psycopg://dockbot@127.0.0.1:5432/dockbot
DATABASE_URL=

# Часовой пояс склада, имя IANA. В ТЗ не задан.
WAREHOUSE_TIMEZONE=

# Геометка склада. В ТЗ не задана.
WAREHOUSE_LATITUDE=
WAREHOUSE_LONGITUDE=

# Окно отмены и переноса, целые часы. В ТЗ не задано.
CANCEL_WINDOW_HOURS=

# Сетка слотов. Пустые ключи — сетка не задана.
# Пример ворот: 1:Ворота 1;2:Ворота 2
GATES=
# Дни ISO: 1=понедельник … 7=воскресенье. Пример: 1,2,3,4,5
GATE_WEEKDAYS=
# Пример: 08:00 и 18:00
GATE_OPEN=
GATE_CLOSE=
SLOT_MINUTES=

# Персонал. Пустой ключ не меняет уже записанных сотрудников.
# Форма: роль:имя:PIN или роль:имя:PIN:telegram_id
# Роль: security или warehouse. Несколько записей через точку с запятой.
# PIN персонала — не PIN пропуска. В репозиторий его не кладут.
# Заранее известный Telegram ID без PIN: security:Охрана::1000000001
STAFF=
